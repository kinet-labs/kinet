[Unit]
Description="Service file for Kinet BFT"
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kinet-node \
    --secp-identity /home/kinet/kinet/config/id-secp \
    --bls-identity /home/kinet/kinet/config/id-bls \
    --node-config /home/kinet/kinet/config/node.toml \
    --forkpoint-config /home/kinet/kinet/config/forkpoint/forkpoint.toml \
    --wal-path /home/kinet/kinet/wal \
    --mempool-ipc-path /home/kinet/kinet/mempool.sock \
    --control-panel-ipc-path /home/kinet/kinet/controlpanel.sock \
    --statesync-ipc-path /home/kinet/kinet/statesync.sock \
    --ledger-path /home/kinet/kinet/ledger \
    --triedb-path /dev/triedb \
    --otel-endpoint "http://127.0.0.1:4317" \
    --statesync-sq-thread-cpu 8 \
    --record-metrics-interval-seconds 1 \
    --validators-path /home/kinet/kinet/config/validators/validators.toml \
    --persisted-peers-path /home/kinet/kinet/config/peers.toml \
    --keystore-password "${KEYSTORE_PASSWORD}"
EnvironmentFile=-/home/kinet/.env
Environment="RUST_LOG=debug,h2=warn,tower=warn,opentelemetry_sdk=warn,opentelemetry-otlp=warn"
Restart=no
User=kinet
Group=kinet
AllowedCPUs=8-11
CPUAffinity=8,9,10,11
DeviceAllow=/dev/triedb rw
LimitNOFILE=1048576
# Hugemem configs below
LimitMEMLOCK=infinity
MemoryDenyWriteExecute=false
#SystemCallFilter=~@memlock
ProtectKernelModules=no
ProtectKernelLogs=no

[Install]
WantedBy=multi-user.target
